---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Color Picker Widget Demo</title>
    <style>
      :root {
        --demo-accent: #2563eb;
        --demo-accent-strong: #1d4ed8;
        --demo-surface: #f8fafc;
        --demo-text: #111827;
        --demo-muted: #64748b;
        --demo-border: #bfdbfe;
      }

      [data-theme="warm"] {
        --demo-accent: #b45309;
        --demo-accent-strong: #92400e;
        --demo-surface: #fff7ed;
        --demo-text: #431407;
        --demo-muted: #78716c;
        --demo-border: #fed7aa;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        color: var(--demo-text);
        background:
          linear-gradient(180deg, var(--demo-surface), #ffffff 56%),
          var(--demo-surface);
      }

      main {
        width: min(960px, calc(100% - 32px));
        margin: 0 auto;
        padding: 48px 0 72px;
      }

      .demo-stack {
        display: grid;
        gap: 20px;
      }

      h1 {
        margin: 0 0 16px;
        color: var(--demo-accent);
      }

      .sample-card {
        border: 1px solid var(--demo-border);
        border-radius: 8px;
        padding: 24px;
        background: white;
      }

      .sample-card p {
        color: var(--demo-muted);
      }

      .sample-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }

      .sample-panel {
        border: 1px solid var(--demo-border);
        border-radius: 8px;
        padding: 18px;
        background: white;
      }

      .sample-panel h2 {
        margin: 0 0 8px;
        color: var(--demo-accent-strong);
        font-size: 18px;
      }

      .sample-panel p {
        margin: 0;
      }

      .sample-button {
        display: inline-flex;
        align-items: center;
        margin-top: 20px;
        border: 0;
        border-radius: 6px;
        padding: 10px 14px;
        color: white;
        background: var(--demo-accent);
      }

      .sample-outline {
        display: inline-flex;
        align-items: center;
        margin-top: 12px;
        border: 1px solid var(--demo-accent);
        border-radius: 6px;
        padding: 9px 13px;
        color: var(--demo-accent);
        background: transparent;
      }

      .sample-transparent {
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        padding: 16px;
        color: rgba(15, 23, 42, 0);
        background: transparent;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="demo-stack">
        <section class="sample-card" id="primary-card">
          <h1>Color Picker Demo</h1>
          <p>
            This page gives the toolbar app text, background, border, repeated
            selectors, transparent values, and CSS variable colors to inspect.
          </p>
          <button class="sample-button" type="button">Token button</button>
          <a class="sample-outline" href="https://astro.build">Pick-safe link</a>
        </section>

        <section class="sample-grid" aria-label="Color scenarios">
          <article class="sample-panel">
            <h2>Direct properties</h2>
            <p style="color: #be123c; background-color: #fff1f2;">
              Inline color and background values.
            </p>
          </article>

          <article class="sample-panel" data-theme="warm">
            <h2>Scoped variables</h2>
            <p>
              This panel changes color through a scoped custom property set.
            </p>
            <button class="sample-button" type="button">Warm token</button>
          </article>

          <article class="sample-panel repeated-card">
            <h2>Repeated selector</h2>
            <p>Use this with <code>.repeated-card</code> to test ambiguity.</p>
          </article>

          <article class="sample-panel repeated-card">
            <h2>Repeated selector</h2>
            <p>The manual selector flow should choose the first selectable match.</p>
          </article>

          <article class="sample-transparent">
            Transparent text sample for unsupported or unset color handling.
          </article>
        </section>
      </div>
    </main>
  </body>
</html>
