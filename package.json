{
  "name": "astro-color-picker-widget",
  "version": "0.0.0",
  "private": true,
  "description": "Astro Dev Toolbar color picker widget scaffold.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "demo:build": "npm --workspace demo run build",
    "validate": "npm run check && npm run build && npm run test && npm run demo:build"
  },
  "workspaces": [
    "demo"
  ],
  "peerDependencies": {
    "astro": ">=6.1.8 <7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "astro": "6.1.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "18.20.8 || ^20.3.0 || >=22.0.0"
  }
}
