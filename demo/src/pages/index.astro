---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Color Picker Widget Demo</title>
    <style>
      :root {
        --demo-accent: #2563eb;
        --demo-surface: #f8fafc;
        --demo-text: #111827;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        color: var(--demo-text);
        background: var(--demo-surface);
      }

      main {
        width: min(720px, calc(100% - 32px));
        margin: 0 auto;
        padding: 64px 0;
      }

      h1 {
        margin: 0 0 16px;
        color: var(--demo-accent);
      }

      .sample-card {
        border: 1px solid color-mix(in srgb, var(--demo-accent), white 65%);
        border-radius: 8px;
        padding: 24px;
        background: white;
      }

      .sample-button {
        display: inline-flex;
        align-items: center;
        margin-top: 20px;
        border: 0;
        border-radius: 6px;
        padding: 10px 14px;
        color: white;
        background: var(--demo-accent);
      }
    </style>
  </head>
  <body>
    <main>
      <section class="sample-card">
        <h1>Color Picker Demo</h1>
        <p>
          This page gives the toolbar app simple text, background, border, and
          CSS variable colors to inspect in later phases.
        </p>
        <button class="sample-button" type="button">Sample button</button>
      </section>
    </main>
  </body>
</html>
